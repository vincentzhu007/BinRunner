{
  "app": {
    // 签名材料与口令是本机/账号相关的，不入库（注入逻辑见 build.sh）：
    //   - 本机 CLI 构建：build.sh 用 .build/build-profile.local.json5（已 gitignore）
    //     覆盖本文件，构建结束后还原；没有本机配置时产出未签名 HAP（不可安装）。
    //   - DevEco Studio 自动签名：IDE 会就地改写本文件，注意不要提交进来。
    //   - CI/发布：build.sh 用 GitHub Secrets + hap-sign-tool 签名，不读这里。
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "compatibleSdkVersion": "5.0.0(12)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        },
        "targetSdkVersion": "6.1.0(23)"
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
